<% errors = object.errors.full_messages.uniq %>
<% if errors.any? %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <strong><i class="bi bi-exclamation-triangle-fill me-1"></i>Nelze přihlásit:</strong>
    <ul class="mb-0 mt-1">
      <% errors.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
  </div>
<% end %>
