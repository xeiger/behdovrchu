<footer class="bdv-footer">
  <div class="container">
    <div class="row gy-4">
      <div class="col-md-5">
        <h2>Kontakt</h2>
        <p class="mb-2">BeskydSki, spolek</p>
        <ul class="bdv-footer-links">
          <li><i class="bi bi-envelope"></i><a href="mailto:behdovrchu@email.cz">behdovrchu@email.cz</a></li>
          <li><i class="bi bi-globe2"></i><a href="https://behdovrchu.herokuapp.com/">behdovrchu.herokuapp.com</a></li>
          <li><i class="bi bi-facebook"></i><a href="https://www.facebook.com/BehDoVrchu/" target="_blank" rel="noopener">facebook – BehDoVrchu</a></li>
        </ul>
      </div>
      <div class="col-md-4">
        <h2>Závod</h2>
        <ul class="bdv-footer-links">
          <% nav_items.each do |label, path, _| %>
            <li><i class="bi bi-chevron-right"></i><%= link_to label, path %></li>
          <% end %>
        </ul>
      </div>
      <div class="col-md-3">
        <h2><%= RACE[:edition] %>. ročník</h2>
        <p class="mb-0">sobota <%= short_date(RACE[:date]) %><br>Hotel Ráztoka – Pustevny<br>start 12:00</p>
      </div>
    </div>
    <div class="bdv-footer-bottom d-flex flex-column flex-sm-row justify-content-between gap-1">
      <span>Design by xEiger</span>
      <span>&copy; <%= Date.today.year %> BeskydSki. Všechna práva vyhrazena.</span>
    </div>
  </div>
</footer>
