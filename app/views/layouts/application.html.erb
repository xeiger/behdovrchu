<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= [yield(:page_title).presence, 'Běh do vrchu Ráztoka – Pustevny'].compact.join(' | ') %></title>
    <meta name="description" content="Tradiční běžecký závod do vrchu od Hotelu Ráztoka na Pustevny. <%= RACE[:edition] %>. ročník se běží v sobotu <%= short_date(RACE[:date]) %>.">
    <%= csrf_meta_tags %>
    <link rel="icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
    <%= stylesheet_link_tag 'application', media: 'all' %>
  </head>

  <body>
    <%= render 'partials/navbar' %>

    <main>
      <%= yield :hero %>
      <% if content_for?(:page_title) %>
        <%= render 'partials/page_header', title: yield(:page_title) %>
      <% end %>
      <%= yield %>
    </main>

    <%= render 'partials/footer' %>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
