<% content_for :page_title, 'Výsledky' %>
<%
  # Vysledky aktualniho rocniku: jeden radek = jeden zavodnik
  # [poradi, J, A, B, C, D, ZJ, ZA, ZB, st. cislo, jmeno, oddil, rocnik, cas, ztrata]
  results = [
    
  ]

  # starsi rocniky: [cislo rocniku, rok] - PDF jsou v public/hlavni_zavod_ROK.pdf a detsky_zavod_ROK.pdf
  older = [[55, 2025], [54, 2024], [53, 2023], [52, 2022], [50, 2019], [49, 2018], [48, 2017], [47, 2016], [46, 2015]]
%>

<section class="py-5">
  <div class="container">

    <ul class="nav bdv-pills mb-4" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-actual" data-bs-toggle="tab" data-bs-target="#actual" type="button" role="tab" aria-controls="actual" aria-selected="true">Aktuální ročník</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-older" data-bs-toggle="tab" data-bs-target="#older" type="button" role="tab" aria-controls="older" aria-selected="false">Starší ročníky</button>
      </li>
    </ul>

    <div class="tab-content">

      <div class="tab-pane fade show active" id="actual" role="tabpanel" aria-labelledby="tab-actual">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
          <h2 class="bdv-section-title mb-0">Výsledky <%= RACE[:edition] %>. ročníku</h2>
          <% if RACE[:results_pdf] %>
            <div class="d-flex flex-wrap gap-2">
              <a class="btn btn-outline-brand btn-sm" href="/hlavni_zavod_<%= RACE[:year] %>.pdf" target="_blank"><i class="bi bi-file-earmark-pdf me-1"></i>Hlavní závod (PDF)</a>
              <a class="btn btn-outline-brand btn-sm" href="/detsky_zavod_<%= RACE[:year] %>.pdf" target="_blank"><i class="bi bi-file-earmark-pdf me-1"></i>Dětský závod (PDF)</a>
            </div>
          <% end %>
        </div>

        <% if results.empty? %>
          <div class="bdv-note">
            <p><i class="bi bi-hourglass-split me-2"></i>Výsledky <%= RACE[:edition] %>. ročníku doplníme krátce po závodě, který se běží v sobotu <%= short_date(RACE[:date]) %>. Do té doby se podívejte na starší ročníky.</p>
          </div>
        <% else %>
          <div class="bdv-table-wrap">
            <div class="table-responsive">
              <table class="table table-brand table-striped table-hover align-middle mb-0 text-nowrap">
                <thead>
                  <tr>
                    <th rowspan="2" class="align-middle">#</th>
                    <th colspan="5" class="text-center">Muži</th>
                    <th colspan="3" class="text-center">Ženy</th>
                    <th rowspan="2" class="align-middle text-center">St. číslo</th>
                    <th rowspan="2" class="align-middle">Jméno</th>
                    <th rowspan="2" class="align-middle">Oddíl</th>
                    <th rowspan="2" class="align-middle text-center">Ročník</th>
                    <th rowspan="2" class="align-middle text-center">Čas</th>
                    <th rowspan="2" class="align-middle text-center">Ztráta</th>
                  </tr>
                  <tr>
                    <% %w[J A B C D ZJ ZA ZB].each do |c| %><th class="text-center w-cat"><%= c %></th><% end %>
                  </tr>
                </thead>
                <tbody>
                  <% results.each_with_index do |r, index| %>
                    <tr>
                      <td class="text-muted"><%= index + 1 %></td>
                      <% (1..8).each do |i| %><td class="text-center fw-semibold"><%= r[i] %></td><% end %>
                      <td class="text-center"><%= r[9] %></td>
                      <td class="fw-semibold"><%= r[10] %></td>
                      <td><%= r[11] %></td>
                      <td class="text-center"><%= r[12] %></td>
                      <td class="text-center"><%= r[13] %></td>
                      <td class="text-center text-muted"><%= r[14] %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>

      <div class="tab-pane fade" id="older" role="tabpanel" aria-labelledby="tab-older">
        <h2 class="bdv-section-title">Starší ročníky</h2>
        <div class="row g-3">
          <% older.each do |edition, year| %>
            <div class="col-sm-6 col-lg-4">
              <div class="bdv-year-card">
                <h3><%= year %> <small><%= edition %>. ročník</small></h3>
                <ul>
                  <li><i class="bi bi-file-earmark-pdf"></i><a href="/hlavni_zavod_<%= year %>.pdf" target="_blank">Hlavní závod</a></li>
                  <li><i class="bi bi-file-earmark-pdf"></i><a href="/detsky_zavod_<%= year %>.pdf" target="_blank">Dětský závod</a></li>
                </ul>
              </div>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</section>
