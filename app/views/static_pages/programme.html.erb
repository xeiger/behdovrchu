<% content_for :page_title, 'Propozice' %>
<%
  y = RACE[:year]

  main = [
    ['Datum konání', "<b>sobota #{short_date(RACE[:date])}</b>"],
    ['Start závodu', '12:00, hromadný'],
    ['Trať závodu', '<b>Beží se od Hotelu Ráztoka po Knížecí cestě do prostoru horní stanice lanové dráhy. Délka trati je 5700&nbsp;m, převýšení je 400&nbsp;m.</b>'],
    ['Prezence', 'Probíhá v den závodu před Hotelem Ráztoka a to od 9:00 do 11:00.'],
    ['Startovné', "Při přihlášení a zaplacení předem <b>#{RACE[:fee]} Kč</b> (platba musí přijít na účet do <b>#{short_date(RACE[:payment_deadline])}</b> včetně), po tomto termínu a&nbsp;v&nbsp;den závodu <b>#{RACE[:fee_late]} Kč</b>."],
    ['Přihlášky', "Přihlašujte se prostřednictvím <a href='#{new_entrant_path}'>webového formuláře</a>. Po odeslání formuláře obdržíte email s platebními údaji. (Máte-li zájem o hromadnou přihlášku, kontaktujte nás prosím emailem.)"],
  ]
  main_categories = [
    ['Muži', 'J',  '17 let a méně', "#{y - 17} a mladší"],
    ['Muži', 'A',  '18 – 39 let',   "#{y - 39} – #{y - 18}"],
    ['Muži', 'B',  '40 – 49 let',   "#{y - 49} – #{y - 40}"],
    ['Muži', 'C',  '50 – 59 let',   "#{y - 59} – #{y - 50}"],
    ['Muži', 'D',  '60 let a více', "#{y - 60} a starší"],
    ['Ženy', 'ZJ', '17 let a méně', "#{y - 17} a mladší"],
    ['Ženy', 'ZA', '18 – 39 let',   "#{y - 39} – #{y - 18}"],
    ['Ženy', 'ZB', '40 let a více', "#{y - 40} a starší"],
  ]
  main_notes = [
    "<b>Limit v hlavním závodě je #{RACE[:capacity]} startujících</b>",
    'Každý <b>předem přihlášený</b> závodník obdrží při prezentaci tradiční tričko (při přihlášení na místě pouze do vydání zásob)',
    '<b>Startovní číslo musí být umístěno viditelně na prsou</b>',
    'Pro závodníky bude zajištěn vývoz oblečení na Pustevny',
    'V cíli bude pro závodníky zajištěn čaj',
    'Vyhlášení závodu bude probíhat na Pustevnách v prostoru cíle přibližně ve 14:00',
    'Parkování aut je možné na veřejných parkovištích v Ráztoce',
    '<b>Každý závodník startuje na vlastní nebezpečí</b>',
    'Závod se koná za každého počasí',
  ]

  kids = [
    ['Datum konání', "<b>sobota #{short_date(RACE[:date])}</b>"],
    ['Start závodu', '10:00, hromadný'],
    ['Trať závodu', 'Beží se od Hotelu Ráztoka ke spodní stanici lanové dráhy. Délka trati je 600&nbsp;m.'],
    ['Prezence', 'Probíhá v den závodu v bufetu Hotelu Ráztoka a to od 8:30 do 9:30.'],
    ['Startovné', 'Dětský závod je bez startovného.'],
    ['Přihlášky', 'Přihlašuje se na místě v den závodu při prezentaci. V případě, že se chystáte přijet s větší skupinou dětí, dejte nám, prosím, vědět na náš email.'],
  ]
  kids_categories = [
    ['Děti',    'M', '1 – 5 let',   "#{y - 5} – #{y - 1}"],
    ['Chlapci', 'O', '6 – 7 let',   "#{y - 7} – #{y - 6}"],
    ['Chlapci', 'P', '8 – 10 let',  "#{y - 10} – #{y - 8}"],
    ['Chlapci', 'R', '11 – 13 let', "#{y - 13} – #{y - 11}"],
    ['Dívky',   'S', '6 – 7 let',   "#{y - 7} – #{y - 6}"],
    ['Dívky',   'T', '8 – 10 let',  "#{y - 10} – #{y - 8}"],
    ['Dívky',   'U', '11 – 13 let', "#{y - 13} – #{y - 11}"],
  ]
  kids_notes = [
    'Vyhlášení závodu bude probíhat před Hotelem Ráztoka ihned po závodě (po přesunutí závodníků zpět do Ráztoky)',
    '<b>Každý závodník startuje na vlastní nebezpečí</b>',
    'Závod se koná za každého počasí',
    'Děti můžou běžet v doprovodu rodičů',
  ]
%>

<div class="bdv-anchor-nav">
  <div class="container">
    <ul class="nav bdv-pills">
      <li class="nav-item"><a class="nav-link" href="#hlavni-zavod">Hlavní závod</a></li>
      <li class="nav-item"><a class="nav-link" href="#deti">Závod dětí</a></li>
    </ul>
  </div>
</div>

<% [['hlavni-zavod', 'Hlavní závod', main, main_categories, main_notes, 'Kategorie hlavního závodu'],
    ['deti', 'Závod dětí', kids, kids_categories, kids_notes, 'Kategorie dětského závodu']].each do |id, title, info, categories, notes, cat_title| %>
  <section id="<%= id %>" class="py-5">
    <div class="container">
      <h2 class="bdv-section-title"><%= title %></h2>

      <dl class="bdv-info">
        <% info.each do |key, value| %>
          <div class="bdv-info-row">
            <dt><%= key %></dt>
            <dd><%= raw value %></dd>
          </div>
        <% end %>
      </dl>

      <div class="row g-4 mt-2">
        <div class="col-lg-7">
          <h3 class="h4 mb-3"><%= cat_title %></h3>
          <div class="bdv-table-wrap">
            <table class="table table-brand table-striped align-middle mb-0">
              <thead>
                <tr>
                  <th colspan="2">Kategorie</th>
                  <th>Věk</th>
                  <th>Ročník narození</th>
                </tr>
              </thead>
              <tbody>
                <% categories.each do |group, code, age, years| %>
                  <tr>
                    <td><%= group %></td>
                    <td class="w-cat fw-semibold"><%= code %></td>
                    <td><%= age %></td>
                    <td><%= years %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="col-lg-5">
          <h3 class="h4 mb-3">Doplňující informace</h3>
          <ul class="bdv-list">
            <% notes.each do |note| %>
              <li><i class="bi bi-check2-circle"></i><span><%= raw note %></span></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </section>
<% end %>
